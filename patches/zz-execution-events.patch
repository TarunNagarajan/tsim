+  bool cta_barrier_complete(const NamedBarrier& nb, const BlockCtx& ctx) const {
+    if (!nb.participants) return false;
+    if (nb.count) return nb.arrived >= nb.count;
+    uint64_t live = 0;
+    for (size_t i = 0; i < ctx.warps->size(); ++i)
+      if ((*ctx.warps)[i].state != Warp::State::Done) live |= uint64_t{1} << i;
+    return (nb.participants & live) == live;
+  }
+
+  void release_cta_barrier(const BlockCtx& ctx, unsigned id) {
+    NamedBarrier& nb = ctx.bars->bar[id];
+    for (size_t i = 0; i < ctx.warps->size(); ++i)
+      if (nb.waiting >> i & 1) {
+        Warp& other = (*ctx.warps)[i];
+        other.state = Warp::State::Ready;
+        if (nb.reduction) other.bar_red_result = nb.acc;
+      }
+    if (tsim::execution_events().enabled()) {
+      std::vector<unsigned long long> arrivals, exits;
+      for (size_t i = 0; i < ctx.warps->size(); ++i) {
+        if (nb.participants >> i & 1) arrivals.push_back(nb.event_arrivals[i]);
+        else if (!nb.count && (*ctx.warps)[i].state == Warp::State::Done)
+          exits.push_back((*ctx.warps)[i].exit_event);
+      }
+      tsim::execution_events().cta_barrier_release(cfg_.tsim_launch_id, fn_.name, ctx.ctaid,
+          id, nb.phase, nb.count, nb.reduction, nb.participants, nb.waiting, arrivals, exits, nb.acc);
+    }
+    // Publish arrival snapshots, never writes performed by nonwaiting
+    // producers after their bar.arrive. Only waiters acquire this phase.
+    if (ctx.shadow) ctx.shadow->complete(id, nb.waiting);
+    const uint64_t next_phase = nb.phase + 1;
+    nb = NamedBarrier{};
+    nb.phase = next_phase;
+  }
