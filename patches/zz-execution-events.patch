+  unsigned barrier_operand(Warp& w, const BlockCtx& ctx, const Instr& ins,
+                           const Operand& operand, Mask mask, const char* name) {
+    Lanes scratch;
+    const Lanes& values = read_operand(w, ctx, ins, operand, scratch);
+    const uint32_t value = static_cast<uint32_t>(values[first_set(mask)]);
+    for (uint32_t lane = 0; lane < W_; ++lane)
+      if ((mask & (Mask{1} << lane)) && static_cast<uint32_t>(values[lane]) != value)
+        ctx_fail(ins, static_cast<int>(lane), Err::UnsupportedPtx,
+                 std::string("CTA barrier ") + name + " must agree within the participating warp");
+    return value;
+  }
+
+  NamedBarrier& arrive_cta_barrier(Warp& w, const BlockCtx& ctx, const Instr& ins,
+                                  unsigned id, unsigned count, unsigned reduction) {
+    if (id > 15)
+      ctx_fail(ins, -1, Err::InvalidValue,
+               "barrier " + std::to_string(id) + ": a CTA has barriers 0 to 15");
+    NamedBarrier& nb = ctx.bars->bar[id];
+    if (nb.participants && (nb.count != count || nb.reduction != reduction))
+      ctx_fail(ins, -1, Err::UnsupportedPtx,
+               "barrier " + std::to_string(id) + " phase " + std::to_string(nb.phase) +
+               ": arrivals disagree on participation mode, thread count or reduction operation; these mixed active barrier forms are unsupported");
+    const uint64_t bit = uint64_t{1} << cur_warp_;
+    if (nb.participants & bit)
+      ctx_fail(ins, -1, Err::UnsupportedPtx,
+               "barrier " + std::to_string(id) + " phase " + std::to_string(nb.phase) +
+               ": a warp arrived twice before the barrier completed");
+    nb.count = count;
+    nb.reduction = reduction;
+    nb.participants |= bit;
+    nb.arrived += W_;
+    w.barrier_id = static_cast<uint8_t>(id);
+    if (ctx.shadow) ctx.shadow->arrive(id, cur_warp_);
+    ++stats_.barriers;
+    return nb;
+  }
+
+  unsigned cta_barrier_count(Warp& w, const BlockCtx& ctx, const Instr& ins,
+                             const Operand& operand, Mask mask) {
+    const unsigned count = barrier_operand(w, ctx, ins, operand, mask, "thread count");
+    if (count == 0 || count % W_)
+      ctx_fail(ins, -1, Err::InvalidValue,
+               "a barrier's thread count must be a non-zero multiple of the warp size (" +
+               std::to_string(W_) + "); got " + std::to_string(count));
+    return count;
+  }
