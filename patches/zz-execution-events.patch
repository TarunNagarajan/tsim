+// These malformed kernels used to pass because the scheduler released all
+// uncounted waiters together, regardless of their barrier identity.
+VTEST(whole_cta_barriers_with_distinct_ids_do_not_join) {
+  MemoryManager mem{1 << 20};
+  auto err = VCAPTURE(Error, run(R"(
+.visible .entry k() {
+  .reg .b32 %r<3>;
+  mov.u32 %r1, %tid.x;
+  shr.u32 %r2, %r1, 5;
+  bar.sync %r2;
+  ret;
+})", 64, {}, mem));
+  VCHECK_CONTAINS(err.message(), "deadlock");
+  VCHECK_CONTAINS(err.message(), "barrier 0: 1 warp(s) waiting");
+  VCHECK_CONTAINS(err.message(), "barrier 1: 1 warp(s) waiting");
+}
+
+VTEST(whole_cta_reductions_with_distinct_ids_do_not_join) {
+  MemoryManager mem{1 << 20};
+  auto err = VCAPTURE(Error, run(R"(
+.visible .entry k() {
+  .reg .b32 %r<4>;
+  .reg .pred %p;
+  mov.u32 %r1, %tid.x;
+  shr.u32 %r2, %r1, 5;
+  setp.eq.u32 %p, %r1, %r1;
+  bar.red.popc.u32 %r3, %r2, %p;
+  ret;
+})", 64, {}, mem));
+  VCHECK_CONTAINS(err.message(), "deadlock");
+  VCHECK_CONTAINS(err.message(), "barrier 0: 1 warp(s) waiting");
+  VCHECK_CONTAINS(err.message(), "barrier 1: 1 warp(s) waiting");
+}
+
